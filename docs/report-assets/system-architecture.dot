digraph system {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.18", ranksep="0.28", fontname="Noto Sans Thai", label="ภาพรวมระบบนำทางแบบ local fusion", labelloc=t, fontsize=19];
  node [shape=box, style="rounded,filled", fillcolor="#e9f3fb", color="#416a89", fontname="Noto Sans Thai", fontsize=12, margin="0.13,0.09"];
  edge [color="#516775", arrowsize=0.7, fontname="Noto Sans Thai", fontsize=10];
  camera [label="กล้อง USB\nภาพ + source timestamp"];
  ai [label="SegFormer + colour veto\nmask: ผ่านได้ / ไม่ผ่าน / unknown"];
  projection [label="Calibration + camera mount\nอ่าน label ในพิกัดพื้นหน่วยเมตร"];
  lidar [label="LiDAR สด\nLaserScan + source timestamp"];
  grid [label="Local grid จาก finite rays\nfree / occupied / unknown", fillcolor="#e6f3ed"];
  goal [label="RViz goal + AMCL/TF\nพิกัดปลายทาง → ทิศเป้าหมายใกล้ตัว", fillcolor="#fff3d9"];
  fusion [label="รวมภาพกับ LiDAR\nสร้าง smoothstep candidates\nตรวจความกว้าง/footprint และเลือกคะแนนต่ำสุด", fillcolor="#e6f3ed"];
  control [label="Pure Pursuit + limiter\nคำนวณ v, ω และตรวจ stop sweep", fillcolor="#e6f3ed"];
  overlay [label="Vision overlay\nเส้นเหลืองจาก reference เดียวกับคอนโทรล", fillcolor="#fff3d9"];
  gates [label="Navigation + trial gates\nข้อมูลสด / permission / เพดาน session", fillcolor="#f2ecfa"];
  link [label="ROS2 link + rosbridge\nผ่าน WebSocket / SSH tunnel", fillcolor="#f2ecfa"];
  gateway [label="ROS1 gateway บนหุ่น\narm / lease / command timeout", fillcolor="#fcebe7"];
  operator [label="ผู้ปฏิบัติงาน\nเริ่ม–หยุด session / permission", fillcolor="#fff3d9"];
  base [label="/cmd_vel → twist_mux → ฐาน Husky", fillcolor="#fcebe7"];
  odom [label="Odometry + TF\npose / measured motion", fillcolor="#e9f3fb"];
  camera -> ai -> projection -> fusion;
  lidar -> grid -> fusion;
  goal -> fusion;
  odom -> goal [label="localization"];
  odom -> control [label="feedback"];
  fusion -> control [label="metric reference"];
  fusion -> overlay [label="reference เดียวกัน"];
  control -> gates -> link -> gateway -> base;
  operator -> gateway [label="local permission"];
  { rank=same; camera; lidar; odom; }
  { rank=same; ai; grid; goal; }
  { rank=same; control; overlay; }
  { rank=same; gateway; operator; }
}
